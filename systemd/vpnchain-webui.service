[Unit]
Description=VPN Chain WebUI peer manager
Documentation=https://github.com/bezeusgptr/AmneziaWG-ProxyChain
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/vpnchain/vpnchain.env
ExecStart=@@REPO@@/scripts/vpnchain-webui-start.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpnchain-webui

[Install]
WantedBy=multi-user.target
